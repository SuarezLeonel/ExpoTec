# =============================================================================
# Plantilla de entorno para Producción (ejemplo sin credenciales reales)
# =============================================================================
NODE_ENV=production
DEMO_MODE=false
PORT=3100
HOST=0.0.0.0
BRANCH_TIMEZONE=America/Argentina/Buenos_Aires
ALLOWED_ORIGINS=https://tu-dominio.com

# Cadena de conexión a base de datos de producción:
# Ejemplo PostgreSQL gestionado:
# DATABASE_URL=postgresql://<USUARIO>:<CONTRASENA>@<HOST>:5432/<BASE_DE_DATOS>?sslmode=require
# Ejemplo TiDB Cloud (MySQL):
# DATABASE_URL=mysql://<USUARIO>:<CONTRASENA>@<HOST>:4000/<BASE_DE_DATOS>?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://<USUARIO>:<CONTRASENA>@<HOST>:4000/<BASE_DE_DATOS>

# Directorio de almacenamiento para comprobantes e imágenes subidas
STORAGE_DIR=/var/data/storage

# Clave secreta para cálculo de idempotencia y tokens de PIN (mínimo 32 caracteres criptográficos)
OPERATION_HASH_KEY=GENERAR_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

